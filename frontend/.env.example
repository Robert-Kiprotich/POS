# Frontend environment variables
# Copy this file to .env and set your values

# API base URL — set to your backend URL
# Local development:
VITE_API_BASE_URL=http://192.168.100.3:8000/inbox/

# With ngrok (replace with your current ngrok URL):
# VITE_API_BASE_URL=https://your-ngrok-url.ngrok-free.app/inbox/

# Production:
# VITE_API_BASE_URL=https://your-domain.com/inbox/
